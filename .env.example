# Sao chép file này thành .env trên VPS rồi điền giá trị thật.
# TUYỆT ĐỐI không commit file .env (đã có trong .gitignore).

# Mật khẩu SA của SQL Server — PHẢI trùng với /opt/yodes/.env vì MMW dùng chung instance đó.
# Lấy tự động: grep '^MSSQL_SA_PASSWORD=' /opt/yodes/.env >> /opt/mmw/.env
MSSQL_SA_PASSWORD=

# Tài khoản admin đầu tiên. Chỉ có tác dụng khi database chưa có user nào.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# RÀO AN TOÀN — tuần chạy thử để nguyên false/true.
# Chỉ đổi LIVE_TRADING_ENABLED=true khi đã xem đủ số liệu và chấp nhận đặt lệnh thật.
LIVE_TRADING_ENABLED=false
LIVE_TRADING_USE_TESTNET=true

# Binance. Dữ liệu nến công khai qua data-api.binance.vision KHÔNG cần key.
# Key chỉ cần cho đồng bộ lệnh/đặt lệnh — để trống nếu tuần này chỉ xem tín hiệu.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# AI service (Claude | DeepSeek | MiniMax | Gemini).
# Để trống thì các job market-scan-shadow / daily-plan / trade-advisor sẽ lỗi,
# nhưng đường sinh lệnh tất định (signal-eval) vẫn chạy bình thường.
AI_PROVIDER=DeepSeek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# Email SMTP — để trống thì chỉ mất thông báo qua mail, app vẫn chạy.
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
