# Sao chép file này thành .env trên VPS rồi điền giá trị thật.
# TUYỆT ĐỐI không commit file .env (đã có trong .gitignore).

# Mật khẩu SA của SQL Server — PHẢI trùng với /opt/yodes/.env vì MMW dùng chung instance đó.
# Lấy tự động: grep '^MSSQL_SA_PASSWORD=' /opt/yodes/.env >> /opt/mmw/.env
MSSQL_SA_PASSWORD=

# Tài khoản admin đầu tiên. Chỉ có tác dụng khi database chưa có user nào.
BOOTSTRAP_ADMIN_USER=admin
BOOTSTRAP_ADMIN_PASSWORD=

# RÀO AN TOÀN. Hai cờ này ĐỘC LẬP nhau:
#   ENABLED=false                  -> không gửi lệnh nào, chỉ sinh tín hiệu
#   ENABLED=true + TESTNET=true    -> đặt lệnh trên testnet, TIỀN ẢO
#   ENABLED=true + TESTNET=false   -> đặt lệnh TIỀN THẬT
LIVE_TRADING_ENABLED=false
LIVE_TRADING_USE_TESTNET=true

# Cap cứng. Không khai thì rơi về mặc định appsettings.json (leverage 20, 10 lệnh/ngày).
LIVE_TRADING_MAX_LEVERAGE=5
LIVE_TRADING_DEFAULT_LEVERAGE=5
LIVE_TRADING_MAX_NOTIONAL_USDT=120
LIVE_TRADING_MAX_ORDERS_PER_DAY=5

# Binance: KHÔNG khai key ở đây. Key được lưu theo từng tài khoản trong bảng TradingAccounts,
# nhập qua giao diện /Accounts. Không thành phần nào đọc Binance:ApiKey từ cấu hình.
# Key testnet lấy ở testnet.binancefuture.com, KHÁC hoàn toàn key sàn thật.

# AI service (Claude | DeepSeek | MiniMax | Gemini).
# Để trống thì các job market-scan-shadow / daily-plan / trade-advisor sẽ lỗi,
# nhưng đường sinh lệnh tất định (signal-eval) vẫn chạy bình thường.
AI_PROVIDER=DeepSeek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# Email SMTP — để trống thì chỉ mất thông báo qua mail, app vẫn chạy.
EMAIL_FROM=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
