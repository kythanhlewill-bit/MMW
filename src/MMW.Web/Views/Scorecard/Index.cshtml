@using MMW.Domain.Enums
@using MMW.Web.Models
@model ScorecardListViewModel
@{
    ViewData["Title"] = "Phiếu chấm điểm";

    string OutcomeBadge(ScorecardOutcome o) => o switch
    {
        ScorecardOutcome.Entered => "bg-green",
        ScorecardOutcome.BelowThreshold => "bg-yellow",
        ScorecardOutcome.SetupMissing => "bg-azure",
        _ => "bg-red",
    };

    string Price(decimal? value) => value is { } v && v > 0m ? v.ToString("0.####") : "—";

    // Dòng tóm tắt phải giữ được một dòng: lý do đầy đủ vẫn còn nguyên ở phần mở rộng ngay dưới.
    string Truncate(string text, int max) =>
        text.Length <= max ? text : text[..max].TrimEnd() + "…";

    string GroupLabel(ScoreGroup g) => g switch
    {
        ScoreGroup.Technical => "Kỹ thuật",
        ScoreGroup.Market => "Thị trường",
        ScoreGroup.Liquidity => "Thanh khoản",
        _ => "Kỷ luật",
    };
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Phiếu chấm điểm</h2>
            <div class="text-secondary mt-1">
                Mọi lần đánh giá đều được lưu, kể cả khi kết luận là không vào lệnh — đó mới là
                phần trả lời được câu hỏi "tại sao hôm nay hệ thống đứng ngoài".
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">Nhóm lệnh</label>
                <select name="style" class="form-select">
                    <option value="">— tất cả —</option>
                    @foreach (var st in Enum.GetValues<MMW.Domain.Enums.TradeStyle>())
                    {
                        var count = Model.StyleCounts.TryGetValue(st, out var c) ? c : 0;
                        <option value="@st" selected="@(Model.Style == st)">
                            @MMW.Web.Models.TradeStyleLabels.Name(st) (@count)
                        </option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Mã</label>
                <input name="symbol" value="@Model.Symbol" class="form-control" placeholder="BTCUSDT" style="text-transform:uppercase" />
            </div>
            <div class="col-auto">
                <label class="form-label">Lý do từ chối</label>
                <select name="veto" class="form-select">
                    <option value="">— tất cả —</option>
                    @foreach (var r in Enum.GetValues<VetoReason>())
                    {
                        <option value="@r" selected="@(Model.Veto == r)">@ScorecardListViewModel.VetoLabel(r)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Kết cục</label>
                <select name="outcome" class="form-select">
                    <option value="">— tất cả —</option>
                    @foreach (var o in Enum.GetValues<ScorecardOutcome>())
                    {
                        <option value="@o" selected="@(Model.Outcome == o)">@ScorecardListViewModel.OutcomeLabel(o)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label">Điểm lớn hơn</label>
                <input type="number" name="minScore" value="@(Model.MinScore?.ToString())"
                       class="form-control" style="width:8rem" min="0" max="100" step="1"
                       placeholder="vd 40" />
            </div>
            <div class="col-auto"><button class="btn btn-primary">Lọc</button></div>
            <div class="col-auto"><a asp-action="Index" class="btn btn-link">Xoá lọc</a></div>
        </form>
    </div>
</div>

<div class="row row-cards mb-3">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Lý do từ chối phổ biến nhất</h3></div>
            @if (Model.VetoCounts.Count == 0)
            {
                <div class="card-body text-secondary">Chưa có phiếu nào bị từ chối.</div>
            }
            else
            {
                <table class="table card-table table-vcenter">
                    @foreach (var kv in Model.VetoCounts)
                    {
                        <tr>
                            <td>@ScorecardListViewModel.VetoLabel(kv.Key)</td>
                            <td class="text-end">@kv.Value</td>
                        </tr>
                    }
                </table>
            }
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Tiêu chí hay về 0 điểm nhất</h3>
                <div class="card-subtitle">Đây chính là dữ liệu để cải tiến thuật toán</div>
            </div>
            @if (Model.ZeroPointCriteria.Count == 0)
            {
                <div class="card-body text-secondary">Chưa có dữ liệu.</div>
            }
            else
            {
                <table class="table card-table table-vcenter">
                    @foreach (var kv in Model.ZeroPointCriteria)
                    {
                        <tr><td><code>@kv.Key</code></td><td class="text-end">@kv.Value</td></tr>
                    }
                </table>
            }
        </div>
    </div>
</div>


@if (Model.Items.Count == 0)
{
    <div class="card"><div class="card-body text-secondary">Không có phiếu nào khớp bộ lọc.</div></div>
}
else
{
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">@Model.Items.Count phiếu gần nhất</h3>
            <div class="card-subtitle">Bấm vào một dòng để mở chi tiết chấm từng tiêu chí.</div>
        </div>
        <div class="table-responsive">
            <table class="table table-sm table-vcenter card-table">
                <thead>
                    <tr>
                        <th style="width:1rem"></th>
                        <th>Giờ VN</th>
                        <th>Nhóm</th>
                        <th>Mã</th>
                        <th>Chiều</th>
                        <th class="text-end">Điểm</th>
                        <th>Kết cục</th>
                        <th class="text-end">Vào</th>
                        <th class="text-end">Dừng lỗ</th>
                        <th class="text-end">Chốt lời</th>
                        <th class="text-end">RR</th>
                        <th class="text-end">Cỡ</th>
                        <th>Vì sao</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var card in Model.Items)
                {
                    var id = $"pc-{card.Id}";
                    var reason = ScorecardListViewModel.BlockReason(card);
                    var takeProfit = card.SuggestedFirstTakeProfit ?? card.SuggestedTakeProfit;

                    <tr role="button" data-bs-toggle="collapse" data-bs-target="#@id"
                        aria-expanded="false" aria-controls="@id">
                        <td class="text-secondary">▸</td>
                        <td class="text-nowrap">@ScorecardListViewModel.Vn(card.CandleCloseTimeUtc)</td>
                        <td>
                            <span class="badge @MMW.Web.Models.TradeStyleLabels.BadgeClass(card.Style)"
                                  title="@MMW.Web.Models.TradeStyleStats.DescriptionOf(card.Style)">
                                @MMW.Web.Models.TradeStyleLabels.Short(card.Style)
                            </span>
                        </td>
                        <td class="text-nowrap"><strong>@card.Symbol</strong> <span class="text-secondary">@card.Interval</span></td>
                        <td>
                            @if (card.Direction is { } direction)
                            {
                                <span class="@(direction == TradeDirection.Long ? "text-green" : "text-red")">
                                    @(direction == TradeDirection.Long ? "mua" : "bán")
                                </span>
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </td>
                        <td class="text-end"><strong>@card.TotalScore</strong><span class="text-secondary">/@card.AvailableMaxPoints</span></td>
                        <td><span class="badge @OutcomeBadge(card.Outcome)">@ScorecardListViewModel.OutcomeLabel(card.Outcome)</span></td>
                        <td class="text-end text-nowrap">@Price(card.SuggestedEntry)</td>
                        <td class="text-end text-nowrap text-red">@Price(card.SuggestedStopLoss)</td>
                        <td class="text-end text-nowrap text-green">@Price(takeProfit)</td>
                        <td class="text-end">@(card.RiskReward?.ToString("0.00") ?? "—")</td>
                        <td class="text-end">@(card.FinalSizeR > 0m ? card.FinalSizeR.ToString("0.##") + "R" : "—")</td>
                        <td class="small text-secondary">@Truncate(reason, 70)</td>
                    </tr>

                    @* Vùng collapse nằm TRONG ô, không phải trên chính <tr>. Bootstrap hoạt ảnh
                       collapse bằng cách chạy height từ 0 lên; trên một hàng bảng thì trình duyệt
                       bỏ qua height và hàng nhảy phịch ra thay vì trượt. Bọc bằng một <div> trả
                       lại cho nó một hộp khối bình thường để chạy hoạt ảnh. *@
                    <tr>
                        <td colspan="13" class="p-0 border-0">
                            <div class="collapse p-3 bg-surface-secondary" id="@id">
                            @if (reason.Length > 0)
                            {
                                <div class="alert @(card.Outcome == ScorecardOutcome.Vetoed ? "alert-danger" : "alert-warning") py-2 mb-2">
                                    <strong>@ScorecardListViewModel.OutcomeLabel(card.Outcome)</strong> — @reason
                                </div>
                            }

                            <div class="row g-2 mb-2 small">
                                <div class="col-auto">Đánh giá lúc <strong>@ScorecardListViewModel.Vn(card.EvaluatedAtUtc)</strong></div>
                                <div class="col-auto">Setup <strong>@ScorecardListViewModel.SetupLabel(card.SetupType)</strong></div>
                                <div class="col-auto">Bộ kích hoạt <strong>@ScorecardListViewModel.TriggerStateLabel(card.TriggerState)</strong></div>
                                @if (card.SuggestedLimitEntry is { } limit)
                                {
                                    <div class="col-auto">Giá chờ <strong>@Price(limit)</strong></div>
                                }
                                @if (card.NetRiskReward is { } net)
                                {
                                    <div class="col-auto">RR sau phí <strong>@net.ToString("0.00")</strong></div>
                                }
                                @if (card.StopDistanceBps is { } bps)
                                {
                                    <div class="col-auto">Bề rộng dừng lỗ <strong>@bps.ToString("0.0") bps</strong></div>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(card.TriggerDetail))
                            {
                                <div class="small text-secondary mb-2">@card.TriggerDetail</div>
                            }

                            @if (card.Lines.Count > 0)
                            {
                                <table class="table table-sm table-vcenter mb-0">
                                    <thead>
                                        <tr><th>Tiêu chí</th><th>Nhóm</th><th class="text-end">Điểm</th><th>Lý do</th></tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var line in card.Lines.OrderBy(l => l.Group).ThenBy(l => l.CriterionKey))
                                    {
                                        <tr class="@(line.IsHardVeto ? "table-danger" : line.AwardedPoints == 0 ? "text-secondary" : "")">
                                            <td><code>@line.CriterionKey</code></td>
                                            <td>@GroupLabel(line.Group)</td>
                                            <td class="text-end">@line.AwardedPoints/@line.MaxPoints</td>
                                            <td class="small">
                                                @line.Reason
                                                @if (!line.DataAvailable)
                                                {
                                                    <span class="badge bg-secondary-lt ms-1">thiếu dữ liệu</span>
                                                }
                                                @if (line.IsApproximation)
                                                {
                                                    <span class="badge bg-azure-lt ms-1">xấp xỉ</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            }
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
