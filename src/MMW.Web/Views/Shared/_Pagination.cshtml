@model MMW.Web.Models.PagerModel
@{
    var req = ViewContext.HttpContext.Request;
    var path = req.Path.ToString();

    // Giữ nguyên mọi query hiện tại, chỉ thay page/pageSize.
    var baseQuery = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
    foreach (var kv in req.Query)
    {
        if (string.Equals(kv.Key, Model.PageParam, StringComparison.OrdinalIgnoreCase)) continue;
        if (string.Equals(kv.Key, Model.PageSizeParam, StringComparison.OrdinalIgnoreCase)) continue;
        baseQuery[kv.Key] = kv.Value.ToString();
    }

    string BuildUrl(int page, int size)
    {
        var q = new Dictionary<string, string>(baseQuery, StringComparer.OrdinalIgnoreCase)
        {
            [Model.PageParam] = page.ToString(),
            [Model.PageSizeParam] = size.ToString(),
        };
        var qs = string.Join("&", q.Select(p => $"{Uri.EscapeDataString(p.Key)}={Uri.EscapeDataString(p.Value)}"));
        return qs.Length == 0 ? path : $"{path}?{qs}";
    }

    var totalPages = Math.Max(1, Model.TotalPages);
    var start = Math.Max(1, Model.CurrentPage - 2);
    var end = Math.Min(totalPages, Model.CurrentPage + 2);
}

<div class="mt-3 d-flex flex-wrap align-items-center justify-content-between gap-2">
    <div class="d-flex align-items-center gap-2">
        <span class="text-secondary small">@Model.TotalCount mục · Trang @Model.CurrentPage/@totalPages</span>
        <select class="form-select form-select-sm w-auto" data-select2-skip="true" aria-label="Số dòng mỗi trang"
                onchange="window.location.href=this.value">
            @foreach (var s in Model.PageSizes)
            {
                <option value="@BuildUrl(1, s)" selected="@(Model.PageSize == s)">@s / trang</option>
            }
        </select>
    </div>
    @if (totalPages > 1)
    {
        <ul class="pagination m-0">
            <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                <a class="page-link" href="@BuildUrl(Model.CurrentPage - 1, Model.PageSize)">Trước</a>
            </li>
            @for (var p = start; p <= end; p++)
            {
                <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                    <a class="page-link" href="@BuildUrl(p, Model.PageSize)">@p</a>
                </li>
            }
            <li class="page-item @(Model.CurrentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" href="@BuildUrl(Model.CurrentPage + 1, Model.PageSize)">Sau</a>
            </li>
        </ul>
    }
</div>
