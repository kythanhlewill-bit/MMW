@{
    var displayName = User.FindFirst("DisplayName")?.Value ?? User.Identity?.Name ?? "User";
    string Active(string controller) =>
        string.Equals((string?)ViewContext.RouteData.Values["controller"], controller, StringComparison.OrdinalIgnoreCase)
            ? "active" : "";
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <title>@ViewData["Title"] - MMW</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0/dist/css/tabler.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.17.0/dist/tabler-icons.min.css" />
    <style>
        .navbar-brand-text { font-weight: 700; letter-spacing: .04em; color: #4dabf7; }
    </style>
</head>
<body class="bg-dark">
    <div class="page">
        <header class="navbar navbar-expand-md d-print-none">
            <div class="container-xl">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <a asp-controller="Home" asp-action="Index" class="navbar-brand navbar-brand-autodark pe-0 pe-md-3">
                    <span class="navbar-brand-text">⚡ MMW</span>
                </a>
                <div class="navbar-nav flex-row order-md-last">
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link d-flex lh-1 p-0 px-2" data-bs-toggle="dropdown">
                            <span class="avatar avatar-sm bg-blue-lt">@displayName.Substring(0, 1).ToUpper()</span>
                            <div class="d-none d-xl-block ps-2">
                                <div>@displayName</div>
                                <div class="mt-1 small text-secondary">@User.Identity?.Name</div>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end">
                            <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                                <button type="submit" class="dropdown-item">
                                    <i class="ti ti-logout me-2"></i> Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <header class="navbar-expand-md">
            <div class="collapse navbar-collapse" id="navbar-menu">
                <div class="navbar">
                    <div class="container-xl">
                        <ul class="navbar-nav">
                            <li class="nav-item @Active("Home")">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">
                                    <span class="nav-link-icon"><i class="ti ti-dashboard"></i></span>
                                    <span class="nav-link-title">Tổng quan</span>
                                </a>
                            </li>
                            <li class="nav-item @Active("Trades")">
                                <a class="nav-link" asp-controller="Trades" asp-action="Index">
                                    <span class="nav-link-icon"><i class="ti ti-list-details"></i></span>
                                    <span class="nav-link-title">Nhật ký lệnh</span>
                                </a>
                            </li>
                            <li class="nav-item @Active("Market")">
                                <a class="nav-link" asp-controller="Market" asp-action="Index">
                                    <span class="nav-link-icon"><i class="ti ti-chart-candle"></i></span>
                                    <span class="nav-link-title">Thị trường</span>
                                </a>
                            </li>
                            <li class="nav-item @Active("Signals")">
                                <a class="nav-link" asp-controller="Signals" asp-action="Index">
                                    <span class="nav-link-icon"><i class="ti ti-bulb"></i></span>
                                    <span class="nav-link-title">Đề xuất lệnh</span>
                                </a>
                            </li>
                            <li class="nav-item @Active("Watchlist")">
                                <a class="nav-link" asp-controller="Watchlist" asp-action="Index">
                                    <span class="nav-link-icon"><i class="ti ti-eye"></i></span>
                                    <span class="nav-link-title">Watchlist</span>
                                </a>
                            </li>
                            <li class="nav-item @Active("Accounts")">
                                <a class="nav-link" asp-controller="Accounts" asp-action="Index">
                                    <span class="nav-link-icon"><i class="ti ti-wallet"></i></span>
                                    <span class="nav-link-title">Tài khoản</span>
                                </a>
                            </li>
                            <li class="nav-item @Active("Settings")">
                                <a class="nav-link" asp-controller="Settings" asp-action="Index">
                                    <span class="nav-link-icon"><i class="ti ti-settings"></i></span>
                                    <span class="nav-link-title">Cài đặt</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </header>
        <div class="page-wrapper">
            <div class="page-body">
                <div class="container-xl">
                    @RenderBody()
                </div>
            </div>
            <footer class="footer footer-transparent d-print-none">
                <div class="container-xl text-center text-secondary small py-3">
                    MMW — Trading Assistant · @DateTime.Now.Year
                </div>
            </footer>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/@@tabler/core@1.0.0/dist/js/tabler.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
