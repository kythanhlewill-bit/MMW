@model MMW.Web.Models.AccountFormModel
@{
    ViewData["Title"] = $"Sửa tài khoản · {Model.Name}";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col"><h2 class="page-title">Sửa tài khoản · @Model.Name</h2></div>
        <div class="col-auto"><a asp-action="Index" class="btn">← Danh sách</a></div>
    </div>
</div>

<form asp-action="Edit" method="post" class="card">
    <input type="hidden" asp-for="Id" />
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Broker"></label>
                <select asp-for="Broker" asp-items="Html.GetEnumSelectList<MMW.Domain.Enums.Broker>()" class="form-select"></select>
            </div>
            <div class="col-md-3">
                <label class="form-label" asp-for="Currency"></label>
                <input asp-for="Currency" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="InitialBalance"></label>
                <input asp-for="InitialBalance" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="CurrentBalance"></label>
                <input asp-for="CurrentBalance" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <label class="form-check form-switch">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <span class="form-check-label">Hoạt động</span>
                </label>
            </div>
        </div>
        <hr class="my-4" />
        <h3 class="mb-3">API Binance (read-only)</h3>
        <p class="text-secondary">Để trống API Secret nếu không muốn thay đổi.</p>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" asp-for="ApiKey"></label>
                <input asp-for="ApiKey" class="form-control" autocomplete="off" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="ApiSecret"></label>
                <input asp-for="ApiSecret" class="form-control" type="password" autocomplete="off" placeholder="(giữ nguyên nếu bỏ trống)" />
            </div>
        </div>
    </div>
    <div class="card-footer text-end">
        <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
</form>
