@using MMW.Domain.Entities
@using MMW.Domain.Enums
@model IReadOnlyList<TradeSignal>
@{
    ViewData["Title"] = "Đề xuất lệnh";
    var symbol = ViewData["Symbol"] as string;
    var confirmBeforeCreate = ViewData["Confirm"] as bool? ?? true;
    var autoCreate = ViewData["AutoCreate"] as bool? ?? false;
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Đề xuất lệnh @(symbol is null ? "" : $"· {symbol}")</h2>
            <div class="text-secondary mt-1">
                Sinh bởi AI từ indicator + tin tức thị trường · @(autoCreate ? "auto tạo lệnh journal khi AI ACCEPT" : "chỉ là gợi ý, chưa tạo lệnh")
            </div>
        </div>
    </div>
</div>

@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

<div class="card">
    @if (Model.Count == 0)
    {
        <div class="empty">
            <p class="empty-title">Chưa có đề xuất</p>
            <p class="empty-subtitle text-secondary">Đề xuất chỉ sinh khi AI thấy setup đủ rõ sau khi đọc indicator và bối cảnh thị trường.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Thời điểm</th><th>Symbol</th><th>Khung</th><th>Hướng</th>
                        <th class="text-end">Entry</th><th class="text-end">SL</th><th class="text-end">TP</th>
                        <th class="text-end">R:R</th><th>Nhận định</th><th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td class="text-secondary small">@VietnamTimeHelper.Format(s.CreatedAt, "dd/MM HH:mm")</td>
                            <td><strong>@s.Symbol</strong></td>
                            <td class="text-secondary">@s.Interval</td>
                            <td>
                                @if (s.Direction == TradeDirection.Long)
                                {
                                    <span class="badge bg-green text-green-fg">Long</span>
                                }
                                else
                                {
                                    <span class="badge bg-red text-red-fg">Short</span>
                                }
                            </td>
                            <td class="text-end">@s.Entry.ToString("N4")</td>
                            <td class="text-end text-red">@s.StopLoss.ToString("N4")</td>
                            <td class="text-end text-green">@s.TakeProfit.ToString("N4")</td>
                            <td class="text-end">@s.RiskReward.ToString("N1")</td>
                            <td class="text-secondary small">@s.Reason</td>
                            <td>
                                @if (confirmBeforeCreate)
                                {
                                    <a asp-controller="Trades" asp-action="Create" asp-route-signalId="@s.Id"
                                       class="btn btn-sm btn-primary">Ghi nhận</a>
                                }
                                else
                                {
                                    <form asp-action="CreateTrade" asp-route-id="@s.Id" method="post" class="m-0">
                                        <button type="submit" class="btn btn-sm btn-primary">Tạo lệnh</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (ViewBag.Pager != null)
{
    @await Html.PartialAsync("_Pagination", (MMW.Web.Models.PagerModel)ViewBag.Pager)
}
