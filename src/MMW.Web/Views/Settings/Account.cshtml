@model MMW.Web.Models.RiskSettingForm
@{
    ViewData["Title"] = $"Cấu hình rủi ro · {Model.AccountName}";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col"><h2 class="page-title">Cấu hình rủi ro · @Model.AccountName</h2></div>
        <div class="col-auto"><a asp-action="Index" class="btn">← Cài đặt</a></div>
    </div>
</div>

<form asp-action="SaveAccount" method="post" class="card">
    <input type="hidden" asp-for="AccountId" />
    <input type="hidden" asp-for="AccountName" />
    <div class="card-header"><h3 class="card-title">Rule Engine + Behavior</h3></div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" asp-for="MaxRiskPerTradePercent"></label>
                <input asp-for="MaxRiskPerTradePercent" class="form-control" type="number" step="0.01" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="MinRiskRewardRatio"></label>
                <input asp-for="MinRiskRewardRatio" class="form-control" type="number" step="0.1" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="MaxTradesPerDay"></label>
                <input asp-for="MaxTradesPerDay" class="form-control" type="number" min="0" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="MaxDailyLossPercent"></label>
                <input asp-for="MaxDailyLossPercent" class="form-control" type="number" step="0.01" />
            </div>
            @*  Hạn mức của nhóm swing đếm RIÊNG. Để chung một bộ đếm thì một lệnh H4 thua
                khoá luôn bộ luật trong ngày tới nửa đêm UTC — bị dừng bởi kết quả của một bộ
                luật khác, trên mã khác, với ví ký quỹ khác. Chỉ có tác dụng khi DualEngine bật. *@
            <div class="col-md-6">
                <label class="form-label" asp-for="MaxRiskPerTradePercentHtf"></label>
                <input asp-for="MaxRiskPerTradePercentHtf" class="form-control" type="number" step="0.01" />
                <div class="form-hint">Cỡ lệnh H4 KHÔNG bám theo cột của lệnh ngắn — bộ luật swing có thể chưa chạy thật lần nào.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="LossStreakThresholdHtf"></label>
                <input asp-for="LossStreakThresholdHtf" class="form-control" type="number" min="0" />
                <div class="form-hint">Chuỗi thua đếm riêng: chuỗi thua của nhóm này không dừng nhóm kia.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="MaxTradesPerDayHtf"></label>
                <input asp-for="MaxTradesPerDayHtf" class="form-control" type="number" min="0" />
                <div class="form-hint">Đếm riêng với lệnh ngắn. Chỉ dùng khi chạy song song hai bộ luật.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="MaxDailyLossPercentHtf"></label>
                <input asp-for="MaxDailyLossPercentHtf" class="form-control" type="number" step="0.01" />
                <div class="form-hint">Dừng nhóm H4 không dừng nhóm lệnh ngắn, và ngược lại.</div>
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="RevengeTradeWindowMinutes"></label>
                <input asp-for="RevengeTradeWindowMinutes" class="form-control" type="number" min="0" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="LossStreakThreshold"></label>
                <input asp-for="LossStreakThreshold" class="form-control" type="number" min="0" />
            </div>
            <div class="col-md-6">
                <label class="form-label" asp-for="TiltSizeIncreasePercent"></label>
                <input asp-for="TiltSizeIncreasePercent" class="form-control" type="number" step="0.1" />
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <label class="form-check form-switch">
                    <input asp-for="RequireStopLoss" class="form-check-input" type="checkbox" />
                    <span class="form-check-label">Bắt buộc Stop Loss</span>
                </label>
            </div>
        </div>
    </div>
    <div class="card-footer text-end">
        <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
</form>
