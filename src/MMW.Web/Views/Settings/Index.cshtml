@model MMW.Web.Models.SettingsViewModel
@{
    ViewData["Title"] = "Cài đặt";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col"><h2 class="page-title">Cài đặt</h2></div>
    </div>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<div class="row row-cards">
    <div class="col-lg-6">
        <form asp-action="SaveGeneral" method="post" class="card">
            <div class="card-header"><h3 class="card-title">Cấu hình chung</h3></div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" asp-for="General.DefaultTradingAccountId"></label>
                    <select asp-for="General.DefaultTradingAccountId" class="form-select">
                        <option value="">— Tài khoản active đầu tiên —</option>
                        @foreach (var a in Model.Accounts)
                        {
                            <option value="@a.Id">@a.Name (@a.Currency)</option>
                        }
                    </select>
                    <small class="text-secondary">Dùng khi tạo lệnh từ đề xuất.</small>
                </div>

                <div class="mb-3">
                    <label class="form-check form-switch">
                        <input asp-for="General.ConfirmBeforeCreateTrade" class="form-check-input" type="checkbox" />
                        <span class="form-check-label">Xác nhận trước khi tạo lệnh</span>
                    </label>
                </div>

                <div class="mb-3">
                    <label class="form-check form-switch">
                        <input asp-for="General.DeterministicEngineEnabled" class="form-check-input" type="checkbox" />
                        <span class="form-check-label fw-semibold">Bật deterministic engine</span>
                    </label>
                    <small class="text-secondary">Bật các job lập kế hoạch, chấm điểm và quản lý vị thế. Không tự bật giao dịch thật.</small>
                </div>

@* Công tắc "so sánh AI shadow" đã gỡ 2026-08-13 cùng với đường AI đề xuất lệnh. Một công tắc
   không còn điều khiển gì tệ hơn là không có công tắc: người dùng sẽ tắt nó rồi tin rằng vừa
   thay đổi một điều gì đó. *@
                <div class="mb-2">
                    <label class="form-label" asp-for="General.MinSignalScore"></label>
                    <input asp-for="General.MinSignalScore" class="form-control" type="number" min="1" max="10" />
                    <small class="text-secondary">Tín hiệu phải đạt điểm này mới sinh đề xuất (1–2 là hợp lý).</small>
                </div>

                <div class="mt-3">
                    <label class="form-check form-switch">
                        <input asp-for="General.AllowOverrideRisk" class="form-check-input" type="checkbox" />
                        <span class="form-check-label text-danger fw-semibold">⚠️ Cho phép đặt lệnh dù vi phạm rule rủi ro</span>
                    </label>
                    <small class="text-secondary d-block">Bật = bỏ qua mọi rào <strong>rủi ro</strong> khi đặt lệnh thật: rule Critical (risk%, RR, daily-loss…), <strong>cap đòn bẩy</strong>, cap notional, giới hạn lệnh/ngày. Vẫn giữ rào <strong>kỹ thuật của sàn</strong>: min-size, min-notional, chống trùng vị thế. <strong>Rất nguy hiểm — chỉ bật khi bạn hiểu rõ.</strong></small>
                </div>
            </div>
            <div class="card-footer text-end">
                <button type="submit" class="btn btn-primary">Lưu</button>
            </div>
        </form>
    </div>

    <div class="col-lg-6">
        <div class="card">
            <div class="card-header"><h3 class="card-title">Cấu hình rủi ro theo tài khoản</h3></div>
            @if (Model.Accounts.Count == 0)
            {
                <div class="card-body text-secondary">Chưa có tài khoản.</div>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var a in Model.Accounts)
                    {
                        <a asp-action="Account" asp-route-id="@a.Id" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                            <span><strong>@a.Name</strong> <span class="text-secondary">@a.Currency · @a.Broker</span></span>
                            <span class="text-secondary">Chỉnh →</span>
                        </a>
                    }
                </div>
            }
        </div>

        <div class="card mt-3">
            <div class="card-header"><h3 class="card-title">Thông báo</h3></div>
            <div class="card-body">
                <p class="text-secondary mb-3">Cấu hình loại cảnh báo nhận trong hệ thống và qua email.</p>
                <a asp-action="Notifications" class="btn btn-primary">
                    <i class="ti ti-bell me-1"></i> Cấu hình thông báo
                </a>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header"><h3 class="card-title">Giao diện</h3></div>
            <div class="card-body">
                <p class="text-secondary mb-3">Chọn giao diện sáng hoặc tối. Lựa chọn được lưu trên trình duyệt này.</p>
                <div class="btn-group" role="group" aria-label="Chọn giao diện">
                    <button type="button" class="btn btn-outline-primary" data-theme-choice="light">
                        <i class="ti ti-sun me-1"></i> Sáng
                    </button>
                    <button type="button" class="btn btn-outline-primary" data-theme-choice="dark">
                        <i class="ti ti-moon me-1"></i> Tối
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var buttons = document.querySelectorAll('[data-theme-choice]');
            function sync() {
                var cur = document.documentElement.getAttribute('data-bs-theme') || 'light';
                buttons.forEach(function (b) {
                    b.classList.toggle('active', b.dataset.themeChoice === cur);
                });
            }
            buttons.forEach(function (b) {
                b.addEventListener('click', function () {
                    if (window.mmwSetTheme) {
                        window.mmwSetTheme(b.dataset.themeChoice);
                    } else {
                        document.documentElement.setAttribute('data-bs-theme', b.dataset.themeChoice);
                    }
                    sync();
                });
            });
            document.addEventListener('mmw-theme-changed', sync);
            sync();
        })();
    </script>
}
