@model MMW.Web.Models.TradeJournalViewModel
@{
    ViewData["Title"] = "Nhật ký lệnh";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Nhật ký lệnh</h2>
        </div>
        <div class="col-auto">
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-plus me-1"></i> Thêm lệnh
            </a>
        </div>
    </div>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}

<div class="card">
    @if (Model.Trades.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon"><i class="ti ti-clipboard-list" style="font-size:2.5rem"></i></div>
            <p class="empty-title">Chưa có lệnh nào</p>
            <p class="empty-subtitle text-secondary">
                Khi bạn thêm lệnh, hệ thống sẽ tự chấm rủi ro và phát hiện hành vi.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Tài khoản</th>
                        <th>Symbol</th>
                        <th>Hướng</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Giá vào</th>
                        <th class="text-end">SL</th>
                        <th class="text-end">TP</th>
                        <th class="text-end">Risk %</th>
                        <th class="text-end">R:R</th>
                        <th class="text-end">PnL</th>
                        <th>Kết quả</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Trades)
                    {
                        var hasAnalysis = t.Status == MMW.Domain.Enums.TradeStatus.Open && Model.Analyses.ContainsKey(t.Id);
                        var analysis = hasAnalysis ? Model.Analyses[t.Id] : null;

                        <tr class="@(hasAnalysis && analysis!.RiskLevel == "Critical" ? "table-danger" : hasAnalysis && analysis!.RiskLevel == "High" ? "table-warning" : "")">
                            <td class="text-secondary">@(t.AccountName ?? "—")</td>
                            <td><strong>@t.Symbol</strong></td>
                            <td>
                                @if (t.Direction == MMW.Domain.Enums.TradeDirection.Long)
                                {
                                    <span class="badge bg-green text-green-fg">Long</span>
                                }
                                else
                                {
                                    <span class="badge bg-red text-red-fg">Short</span>
                                }
                            </td>
                            <td><span class="text-secondary">@t.Status</span></td>
                            <td class="text-end">@t.EntryPrice.ToString("N4")</td>
                            <td class="text-end">@(t.StopLoss?.ToString("N4") ?? "—")</td>
                            <td class="text-end">@(t.TakeProfit?.ToString("N4") ?? "—")</td>
                            <td class="text-end">@(t.RiskPercent?.ToString("N2") ?? "—")</td>
                            <td class="text-end">@(t.PlannedRiskReward?.ToString("N2") ?? "—")</td>
                            <td class="text-end">
                                @if (hasAnalysis)
                                {
                                    <span class="@(analysis!.UnrealizedPnl < 0 ? "text-red" : "text-green")">
                                        @analysis.UnrealizedPnl.ToString("N2")
                                    </span>
                                }
                                else
                                {
                                    <span class="@(t.RealizedPnl < 0 ? "text-red" : t.RealizedPnl > 0 ? "text-green" : "")">
                                        @(t.RealizedPnl?.ToString("N2") ?? "—")
                                    </span>
                                }
                            </td>
                            <td>
                                @if (hasAnalysis)
                                {
                                    var badgeClass = analysis!.RiskLevel switch
                                    {
                                        "Critical" => "bg-red",
                                        "High" => "bg-orange",
                                        "Warning" => "bg-yellow text-yellow-fg",
                                        "Profit" => "bg-green",
                                        _ => "bg-blue-lt"
                                    };
                                    <span class="badge @badgeClass">@analysis.RiskLevel</span>
                                }
                                else
                                {
                                    @switch (t.Outcome)
                                    {
                                        case MMW.Domain.Enums.TradeOutcome.Win:
                                            <span class="badge bg-green-lt">Win</span>
                                            break;
                                        case MMW.Domain.Enums.TradeOutcome.Loss:
                                            <span class="badge bg-red-lt">Loss</span>
                                            break;
                                        case MMW.Domain.Enums.TradeOutcome.BreakEven:
                                            <span class="badge bg-secondary-lt">BE</span>
                                            break;
                                        default:
                                            <span class="text-secondary">—</span>
                                            break;
                                    }
                                }
                            </td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    @if (t.Status != MMW.Domain.Enums.TradeStatus.Closed)
                                    {
                                        <a asp-action="Close" asp-route-id="@t.Id" class="btn btn-sm btn-primary">Đóng</a>
                                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm">Sửa</a>
                                    }
                                    <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="m-0"
                                          onsubmit="return confirm('Xoá lệnh @t.Symbol #@t.Id? Không thể hoàn tác.');">
                                        <button type="submit" class="btn btn-sm btn-ghost-danger">Xoá</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        @if (hasAnalysis)
                        {
                            <tr class="bg-dark-subtle">
                                <td colspan="12" class="py-2 px-3">
                                    <div class="d-flex flex-column gap-1">
                                        <div class="d-flex align-items-start gap-2">
                                            @if (analysis!.AiEnhanced)
                                            {
                                                <span class="badge bg-purple-lt">
                                                    <i class="ti ti-sparkles"></i> AI
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-azure-lt">
                                                    <i class="ti ti-chart-line"></i> Auto
                                                </span>
                                            }
                                            <span>@analysis.Advice</span>
                                        </div>
                                        <div class="text-secondary small">
                                            @analysis.Details
                                            <span class="ms-2 text-muted">· Cập nhật: @analysis.AnalyzedAt.ToString("HH:mm dd/MM")</span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>
