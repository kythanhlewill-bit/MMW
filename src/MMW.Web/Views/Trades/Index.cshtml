@model MMW.Web.Models.TradeJournalViewModel
@{
    ViewData["Title"] = "Nhật ký lệnh";
}

<div class="page-header d-print-none mb-3">
    <div class="row align-items-center">
        <div class="col">
            <h2 class="page-title">Nhật ký lệnh</h2>
        </div>
        <div class="col-auto d-flex gap-2">
            <form asp-action="ImportFromBinance" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary" title="Import vị thế đang mở từ Binance Futures (lệnh đặt tay bên sàn)">
                    <i class="ti ti-download me-1"></i> Import Binance
                </button>
            </form>
            <form asp-action="Sync" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary" title="Đồng bộ kết quả lệnh (fills) từ Binance">
                    <i class="ti ti-refresh me-1"></i> Sync kết quả
                </button>
            </form>
            <a asp-action="Create" class="btn btn-primary">
                <i class="ti ti-plus me-1"></i> Thêm lệnh
            </a>
        </div>
    </div>
</div>

@if (TempData["Message"] is string msg)
{
    <div class="alert alert-success">@msg</div>
}
@if (TempData["Error"] is string err)
{
    <div class="alert alert-danger">@err</div>
}

@if (!Model.OpenOrdersLoaded)
{
    <div class="alert alert-warning d-print-none">
        <i class="ti ti-alert-triangle me-1"></i> Không đọc được lệnh chờ từ Binance (kiểm tra API key/kết nối).
    </div>
}

@if (Model.OpenOrders.Count > 0)
{
    <div class="card mb-3 d-print-none">
        <div class="card-header">
            <h3 class="card-title">
                <i class="ti ti-clock-hour-4 me-1"></i> Lệnh chờ trên sàn
                <span class="badge bg-azure-lt ms-2">@Model.OpenOrders.Count</span>
            </h3>
            <div class="card-subtitle">LIMIT đợi khớp + STOP/TP đang treo · đọc trực tiếp từ Binance, không lưu DB.</div>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>Tài khoản</th>
                        <th>Symbol</th>
                        <th>Loại</th>
                        <th>Hướng</th>
                        <th class="text-end">Giá</th>
                        <th class="text-end">Stop</th>
                        <th class="text-end">Khối lượng</th>
                        <th>Thời gian (VN)</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.OpenOrders)
                    {
                        var o = row.Order;
                        <tr>
                            <td class="text-secondary">@row.AccountName</td>
                            <td><strong>@o.Symbol</strong></td>
                            <td>
                                <span class="badge bg-blue-lt">@o.Type</span>
                                @if (o.ClosePosition)
                                {
                                    <span class="badge bg-orange-lt ms-1" title="Đóng toàn bộ vị thế khi chạm">Close</span>
                                }
                                else if (o.ReduceOnly)
                                {
                                    <span class="badge bg-yellow-lt ms-1" title="Chỉ giảm vị thế">Reduce</span>
                                }
                            </td>
                            <td>
                                @if (o.Side == MMW.Application.MarketData.Models.OrderSide.Buy)
                                {
                                    <span class="badge bg-green text-green-fg">BUY</span>
                                }
                                else
                                {
                                    <span class="badge bg-red text-red-fg">SELL</span>
                                }
                                @if (!string.IsNullOrEmpty(o.PositionSide) && o.PositionSide != "BOTH")
                                {
                                    <span class="text-secondary small ms-1">@o.PositionSide</span>
                                }
                            </td>
                            <td class="text-end">@(o.Price > 0m ? o.Price.ToString("N4") : "—")</td>
                            <td class="text-end">@(o.StopPrice > 0m ? o.StopPrice.ToString("N4") : "—")</td>
                            <td class="text-end">
                                @if (o.ClosePosition)
                                {
                                    <span class="text-secondary">Toàn bộ</span>
                                }
                                else
                                {
                                    @($"{o.ExecutedQty:0.########}/{o.OrigQty:0.########}")
                                }
                            </td>
                            <td class="text-secondary">@VietnamTimeHelper.Format(o.CreatedTimeUtc, "HH:mm dd/MM")</td>
                            <td>
                                <form asp-action="CancelOpenOrder" method="post" class="m-0"
                                      onsubmit="return confirm('Huỷ lệnh chờ @o.Symbol (@o.Type, id @o.OrderId)?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="accountId" value="@row.AccountId" />
                                    <input type="hidden" name="symbol" value="@o.Symbol" />
                                    <input type="hidden" name="orderId" value="@o.OrderId" />
                                    <button type="submit" class="btn btn-sm btn-ghost-danger" title="Huỷ lệnh chờ này trên Binance">
                                        <i class="ti ti-x"></i> Huỷ
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@* ── Kết quả tách theo nhóm lệnh ───────────────────────────────────────────
   Hai nhóm có tỉ lệ thắng và bội R khác hẳn nhau, nên mỗi nhóm một thẻ. Chỉ số quyết định là
   KỲ VỌNG theo R, không phải tỉ lệ thắng — nên nó đứng ở vị trí to nhất, còn tỉ lệ thắng đứng
   cạnh ngưỡng hoà vốn của chính nhóm đó để đọc được ý nghĩa. *@
<div class="row row-cards mb-3">
    @foreach (var s in Model.StyleStats)
    {
        <div class="col-md-6">
            <div class="card @(Model.StyleFilter == s.Style ? "border-primary" : "")">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge @MMW.Web.Models.TradeStyleLabels.BadgeClass(s.Style) me-2">@s.NameVi</span>
                        <span class="text-secondary small">@MMW.Web.Models.TradeStyleStats.DescriptionOf(s.Style)</span>
                    </div>

                    @if (s.Total == 0)
                    {
                        <div class="text-secondary">Chưa có lệnh nào thuộc nhóm này.</div>
                    }
                    else
                    {
                        <div class="row g-2">
                            <div class="col-4">
                                <div class="text-secondary small">Kỳ vọng / lệnh</div>
                                <div class="h2 mb-0 @(s.Expectancy > 0 ? "text-green" : s.Expectancy < 0 ? "text-red" : "")">
                                    @s.Expectancy.ToString("N2")R
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="text-secondary small">Tổng R</div>
                                <div class="h2 mb-0 @(s.TotalR > 0 ? "text-green" : s.TotalR < 0 ? "text-red" : "")">
                                    @s.TotalR.ToString("N2")
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="text-secondary small">Lãi/lỗ</div>
                                <div class="h2 mb-0 @(s.TotalPnl > 0 ? "text-green" : s.TotalPnl < 0 ? "text-red" : "")">
                                    @s.TotalPnl.ToString("N2")
                                </div>
                            </div>
                        </div>

                        <div class="mt-2 small text-secondary">
                            @s.Total lệnh (@s.Open đang mở, @s.Closed đã đóng) ·
                            thắng @s.Wins / thua @s.Losses
                            @if (s.Closed > 0)
                            {
                                <text> · tỉ lệ thắng <strong>@s.WinRate.ToString("N1")%</strong></text>
                                @if (s.BreakevenWinRate is decimal be)
                                {
                                    <text>
                                        , cần <strong class="@(s.WinRate >= be ? "text-green" : "text-red")">@be.ToString("N1")%</strong> để hoà vốn
                                    </text>
                                }
                            }
                        </div>

                        @if (s.Closed >= 5 && s.AvgWinR != 0m && s.AvgLossR != 0m)
                        {
                            <div class="small text-secondary">
                                Lệnh thắng trung bình @s.AvgWinR.ToString("N2")R · lệnh thua @s.AvgLossR.ToString("N2")R
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>

<ul class="nav nav-bordered mb-3 d-print-none">
    <li class="nav-item">
        <a class="nav-link @(Model.StyleFilter is null ? "active" : "")" asp-action="Index">Tất cả</a>
    </li>
    @foreach (var s in Model.StyleStats)
    {
        <li class="nav-item">
            <a class="nav-link @(Model.StyleFilter == s.Style ? "active" : "")"
               asp-action="Index" asp-route-style="@s.Style">
                @s.NameVi <span class="badge bg-secondary-lt ms-1">@s.Total</span>
            </a>
        </li>
    }
</ul>

<div class="card">
    @if (Model.Trades.Count == 0)
    {
        <div class="empty">
            <div class="empty-icon"><i class="ti ti-clipboard-list" style="font-size:2.5rem"></i></div>
            <p class="empty-title">
                @(Model.StyleFilter is null ? "Chưa có lệnh nào" : $"Chưa có lệnh nào thuộc nhóm {MMW.Web.Models.TradeStyleLabels.Name(Model.StyleFilter.Value)}")
            </p>
            <p class="empty-subtitle text-secondary">
                Khi bạn thêm lệnh, hệ thống sẽ tự chấm rủi ro và phát hiện hành vi.
            </p>
        </div>
    }
    else
    {
        @*  Một bộ đánh dấu, hai bố cục. Dưới 992px mỗi <tr> tự gập thành một thẻ nhờ CSS grid
            (xem .trade-table trong site.css) — không có bản sao HTML thứ hai cho điện thoại,
            nên không có đường nào để hai bố cục lệch nhau khi sửa về sau. Nhãn cột trên thẻ lấy
            từ data-label của chính ô đó, vì <thead> bị ẩn ở chế độ thẻ. *@
        <div class="table-responsive">
            <table class="table table-vcenter card-table trade-table">
                <thead>
                    <tr>
                        <th>Nhóm</th>
                        <th>Symbol</th>
                        <th>Hướng</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Giá vào</th>
                        <th class="text-end">Giá hiện tại</th>
                        <th class="text-end">SL</th>
                        <th class="text-end">TP1</th>
                        <th class="text-end">TP</th>
                        <th class="text-end">Risk %</th>
                        <th class="text-end">R:R</th>
                        <th class="text-end">PnL</th>
                        <th>Kết quả</th>
                        <th class="w-1"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in Model.Trades)
                    {
                        var hasAnalysis = t.Status == MMW.Domain.Enums.TradeStatus.Open && Model.Analyses.ContainsKey(t.Id);
                        var analysis = hasAnalysis ? Model.Analyses[t.Id] : null;
                        var isLong = t.Direction == MMW.Domain.Enums.TradeDirection.Long;

                        @*  Giá đang ở đâu. Lệnh đang mở lấy giá mới nhất từ ô phân tích (làm mới mỗi
                            3 phút); lệnh đã đóng thì "hiện tại" của nó chính là giá thoát. *@
                        var livePrice = hasAnalysis && analysis!.CurrentPrice > 0m
                            ? analysis.CurrentPrice
                            : t.Status == MMW.Domain.Enums.TradeStatus.Closed ? t.ExitPrice : null;

                        decimal? movePercent = livePrice is decimal lp && t.EntryPrice > 0m
                            ? (isLong ? lp - t.EntryPrice : t.EntryPrice - lp) / t.EntryPrice * 100m
                            : null;

                        @*  Vị trí của giá trên trục SL → TP, tính theo phần trăm. Đây là thứ trả lời
                            "giá đang ở đâu" nhanh hơn mọi con số: 0% là chạm dừng lỗ, 100% là chạm
                            mục tiêu. Kẹp về [0,100] để giá vượt ra ngoài không đẩy con trỏ ra khỏi
                            thanh — vượt rồi thì lệnh cũng sắp đóng. *@
                        decimal? trackPosition = null;
                        if (livePrice is decimal cur && t.StopLoss is decimal sl && t.TakeProfit is decimal tp)
                        {
                            var span = isLong ? tp - sl : sl - tp;
                            if (span > 0m)
                            {
                                var travelled = isLong ? cur - sl : sl - cur;
                                trackPosition = Math.Clamp(travelled / span * 100m, 0m, 100m);
                            }
                        }

                        @*  Lệnh đóng chỉ chạm ĐÚNG MỘT mức, nhưng CSDL không lưu "đóng vì lý do gì" —
                            chỉ có giá thoát. Nên giờ đóng được gắn cho mức nào nằm trong 0,1% giá
                            thoát. Không mức nào khớp (đóng tay, hết giờ, hoặc dừng lỗ đã bị kéo đi
                            chỗ khác) thì KHÔNG mức nào được gắn giờ — thà để trống còn hơn gắn nhầm
                            một cái giờ mà người đọc sẽ tin là thật. *@
                        bool ClosedAt(decimal? level) =>
                            t.ClosedAt is not null
                            && t.ExitPrice is decimal exit
                            && level is decimal lv && lv > 0m
                            && Math.Abs(exit - lv) / lv <= 0.001m;

                        var rowRisk = hasAnalysis ? analysis!.RiskLevel : null;

                        <tr class="trade-row @(rowRisk == "Critical" ? "trade-row-critical" : rowRisk == "High" ? "trade-row-high" : "")">
                            <td data-label="Nhóm" class="c-grp">
                                <span class="badge @MMW.Web.Models.TradeStyleLabels.BadgeClass(t.Style)"
                                      title="@MMW.Web.Models.TradeStyleStats.DescriptionOf(t.Style)">
                                    @MMW.Web.Models.TradeStyleLabels.Short(t.Style)
                                </span>
                            </td>
                            <td data-label="Symbol" class="c-sym">
                                <strong class="trade-symbol">@t.Symbol</strong>
                                @if (t.LiveStatus != MMW.Domain.Enums.LiveOrderStatus.None)
                                {
                                    var liveBadge = t.LiveStatus switch
                                    {
                                        MMW.Domain.Enums.LiveOrderStatus.Submitted => ("bg-azure text-azure-fg", "LIVE"),
                                        MMW.Domain.Enums.LiveOrderStatus.Filled => ("bg-green text-green-fg", "LIVE ✓"),
                                        MMW.Domain.Enums.LiveOrderStatus.Blocked => ("bg-yellow text-yellow-fg", "BLOCKED"),
                                        MMW.Domain.Enums.LiveOrderStatus.Error => ("bg-red text-red-fg", "LỖI SÀN"),
                                        MMW.Domain.Enums.LiveOrderStatus.Canceled => ("bg-secondary", "HUỶ"),
                                        MMW.Domain.Enums.LiveOrderStatus.EntryPending => ("bg-purple text-purple-fg", "CHỜ KHỚP"),
                                        MMW.Domain.Enums.LiveOrderStatus.SltpPending => ("bg-orange text-orange-fg", "THIẾU SL/TP"),
                                        _ => ("bg-secondary", t.LiveStatus.ToString())
                                    };
                                    <span class="badge @liveBadge.Item1 ms-1" title="@t.LiveNote">@liveBadge.Item2</span>
                                }
                                @*  Tên tài khoản từng chiếm hẳn một cột. Bảng 16 cột không bao giờ
                                    vừa bề ngang khung container-xl (~1290px), và thứ bị đẩy ra khỏi
                                    mép luôn là cột cuối — đúng cột chứa nút Đóng/Sửa/Xoá. Gộp vào
                                    đây, nơi còn chỗ trống sẵn, tốn 0px bề ngang. *@
                                <div class="cell-sub">@(t.AccountName ?? "—")</div>
                            </td>
                            <td data-label="Hướng" class="c-dir">
                                @if (isLong)
                                {
                                    <span class="badge bg-green text-green-fg">Long</span>
                                }
                                else
                                {
                                    <span class="badge bg-red text-red-fg">Short</span>
                                }
                            </td>
                            @*  Trạng thái từng là chữ xám nhạt trên nền tím — dưới ngưỡng tương phản
                                4.5:1 và là thứ đầu tiên mắt cần tìm khi lướt sổ. Đổi thành nhãn có
                                nền, mỗi trạng thái một màu. *@
                            <td data-label="Trạng thái" class="c-status">
                                @{
                                    var statusBadge = t.Status switch
                                    {
                                        MMW.Domain.Enums.TradeStatus.Open => ("bg-azure-lt", "Đang mở"),
                                        MMW.Domain.Enums.TradeStatus.Closed => ("bg-secondary-lt", "Đã đóng"),
                                        MMW.Domain.Enums.TradeStatus.Cancelled => ("bg-red-lt", "Đã huỷ"),
                                        _ => ("bg-purple-lt", "Kế hoạch")
                                    };
                                }
                                <span class="badge @statusBadge.Item1">@statusBadge.Item2</span>
                            </td>
                            <td data-label="Giá vào" class="c-entry text-end num">
                                @t.EntryPrice.ToString("N4")
                                @*  Hai mốc thời gian của cùng một lệnh, xếp cạnh nhau: lúc bộ luật
                                    quyết định vào, và lúc sàn khớp. Khoảng cách giữa chúng chính là
                                    thời gian lệnh chờ nằm treo — thứ mà tách ra hai cột rời thì
                                    không ai trừ nhẩm. *@
                                <div class="cell-time">tạo @VietnamTimeHelper.Format(t.CreatedDate, "HH:mm dd/MM")</div>
                                @if (t.OpenedAt is DateTime opened)
                                {
                                    <div class="cell-time">vào @VietnamTimeHelper.Format(opened, "HH:mm dd/MM")</div>
                                }
                            </td>
                            <td data-label="Giá hiện tại" class="c-now text-end num">
                                @if (livePrice is decimal now)
                                {
                                    var moveClass = movePercent is decimal mv ? (mv > 0m ? "text-green" : mv < 0m ? "text-red" : "") : "";
                                    <span class="price-now @moveClass">@now.ToString("N4")</span>
                                    @if (movePercent is decimal move)
                                    {
                                        <div class="cell-sub @moveClass">@(move >= 0m ? "+" : "")@move.ToString("N2")% so giá vào</div>
                                    }
                                    @if (trackPosition is decimal pos)
                                    {
                                        <div class="price-track" role="img"
                                             aria-label="Giá đang ở @pos.ToString("N0")% quãng đường từ dừng lỗ tới mục tiêu"
                                             title="0% = chạm SL · 100% = chạm TP">
                                            <span class="price-track-fill" style="width:@pos.ToString("N1", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                            <span class="price-track-pin" style="left:@pos.ToString("N1", System.Globalization.CultureInfo.InvariantCulture)%"></span>
                                        </div>
                                        <div class="price-track-legend">
                                            <span>SL</span><span>TP</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td data-label="SL" class="c-sl text-end num">
                                @(t.StopLoss?.ToString("N4") ?? "—")
                                @if (t.TrailUpdateCount > 0)
                                {
                                    <span class="badge bg-teal-lt ms-1" title="Dừng lỗ đã được kéo @t.TrailUpdateCount lần">
                                        ↑@t.TrailUpdateCount
                                    </span>
                                }
                                @if (ClosedAt(t.StopLoss))
                                {
                                    <div class="cell-time text-red">@VietnamTimeHelper.Format(t.ClosedAt!.Value, "HH:mm dd/MM")</div>
                                }
                            </td>
                            @* Mục tiêu gần chỉ có ở lệnh chốt hai phần. Đã chốt rồi thì đánh dấu, để
                               nhìn một cái là biết lệnh đang chạy runner hay vẫn còn nguyên. *@
                            <td data-label="TP1" class="c-tp1 text-end num">
                                @if (t.FirstTakeProfit is decimal tp1)
                                {
                                    <span class="@(t.FirstTargetFilledAt is not null ? "text-green" : "")">@tp1.ToString("N4")</span>
                                    @if (t.FirstTargetFilledAt is DateTime tp1At)
                                    {
                                        <i class="ti ti-check ms-1 text-green" title="Đã chốt phần đầu"></i>
                                        <div class="cell-time text-green">@VietnamTimeHelper.Format(tp1At, "HH:mm dd/MM")</div>
                                    }
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td data-label="TP" class="c-tp text-end num">
                                @(t.TakeProfit?.ToString("N4") ?? "—")
                                @if (ClosedAt(t.TakeProfit))
                                {
                                    <div class="cell-time text-green">@VietnamTimeHelper.Format(t.ClosedAt!.Value, "HH:mm dd/MM")</div>
                                }
                            </td>
                            <td data-label="Risk %" class="c-risk text-end num">@(t.RiskPercent?.ToString("N2") ?? "—")</td>
                            <td data-label="R:R" class="c-rr text-end num">@(t.PlannedRiskReward?.ToString("N2") ?? "—")</td>
                            <td data-label="PnL" class="c-pnl text-end num">
                                @if (hasAnalysis)
                                {
                                    <span class="@(analysis!.UnrealizedPnl < 0 ? "text-red" : "text-green")">
                                        @analysis.UnrealizedPnl.ToString("N2")
                                    </span>
                                    <div class="cell-sub">chưa chốt</div>
                                }
                                else
                                {
                                    <span class="@(t.RealizedPnl < 0 ? "text-red" : t.RealizedPnl > 0 ? "text-green" : "")">
                                        @(t.RealizedPnl?.ToString("N2") ?? "—")
                                    </span>
                                }
                            </td>
                            <td data-label="Kết quả" class="c-result">
                                @if (hasAnalysis)
                                {
                                    var badgeClass = analysis!.RiskLevel switch
                                    {
                                        "Critical" => "bg-red text-red-fg",
                                        "High" => "bg-orange text-orange-fg",
                                        "Warning" => "bg-yellow text-yellow-fg",
                                        "Profit" => "bg-green text-green-fg",
                                        _ => "bg-blue-lt"
                                    };
                                    <span class="badge @badgeClass">@analysis.RiskLevel</span>
                                }
                                else
                                {
                                    @switch (t.Outcome)
                                    {
                                        case MMW.Domain.Enums.TradeOutcome.Win:
                                            <span class="badge bg-green-lt">Win</span>
                                            break;
                                        case MMW.Domain.Enums.TradeOutcome.Loss:
                                            <span class="badge bg-red-lt">Loss</span>
                                            break;
                                        case MMW.Domain.Enums.TradeOutcome.BreakEven:
                                            <span class="badge bg-secondary-lt">BE</span>
                                            break;
                                        default:
                                            <span class="text-secondary">—</span>
                                            break;
                                    }
                                }
                            </td>
                            <td class="c-act">
                                <div class="btn-list flex-nowrap trade-actions">
                                    @{
                                        var canRetry = t.Status != MMW.Domain.Enums.TradeStatus.Closed
                                            && (t.Status == MMW.Domain.Enums.TradeStatus.Cancelled
                                                || t.LiveStatus == MMW.Domain.Enums.LiveOrderStatus.Blocked
                                                || t.LiveStatus == MMW.Domain.Enums.LiveOrderStatus.Error);
                                    }
                                    @if (canRetry)
                                    {
                                        <form asp-action="Reactivate" asp-route-id="@t.Id" method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-warning"
                                                    title="@(t.LiveStatus == MMW.Domain.Enums.LiveOrderStatus.Blocked ? t.LiveNote : "Kích hoạt lại lệnh")">
                                                <i class="ti ti-player-play"></i> Retry
                                            </button>
                                        </form>
                                    }
                                    @if (t.Status != MMW.Domain.Enums.TradeStatus.Closed && t.Status != MMW.Domain.Enums.TradeStatus.Cancelled)
                                    {
                                        <a asp-action="Close" asp-route-id="@t.Id" class="btn btn-sm btn-primary">Đóng</a>
                                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm">Sửa</a>
                                    }
                                    <form asp-action="Delete" asp-route-id="@t.Id" method="post" class="m-0"
                                          onsubmit="return confirm('Xoá lệnh @t.Symbol #@t.Id? Không thể hoàn tác.');">
                                        <button type="submit" class="btn btn-sm btn-ghost-danger">Xoá</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        @if (hasAnalysis)
                        {
                            <tr class="trade-analysis-row">
                                <td colspan="14" class="py-2 px-3">
                                    <div class="trade-analysis-card">
                                        <div class="trade-analysis-main">
                                            <span class="badge trade-analysis-provider trade-analysis-provider-auto">
                                                <i class="ti ti-chart-line"></i> Auto
                                            </span>
                                            <span class="trade-analysis-advice">@analysis!.Advice</span>
                                        </div>
                                        <div class="trade-analysis-details small">
                                            @analysis.Details
                                            <span class="ms-2 trade-analysis-updated">· Cập nhật: @VietnamTimeHelper.Format(analysis.AnalyzedAt, "HH:mm dd/MM")</span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (ViewBag.Pager != null)
{
    @await Html.PartialAsync("_Pagination", (MMW.Web.Models.PagerModel)ViewBag.Pager)
}
